# Database Connection String (MySQL 8.0)
# Local: mysql+pymysql://root:root123@localhost:3307/code_review_db
# Cloud Managed (Railway, Aiven, Supabase): mysql+pymysql://user:password@host:port/dbname?ssl_mode=REQUIRED
DATABASE_URL=mysql+pymysql://root:root123@localhost:3307/code_review_db

# Cryptographic Secret Key for JWT token signing (generate with `openssl rand -hex 32`)
SECRET_KEY=generate_a_secure_random_hex_key_for_production_jwt

# Token Expiry (minutes, default 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration (gemini or openai)
LLM_PROVIDER=gemini
LLM_API_KEY=

# Production Environment & Port
APP_ENV=production
PORT=8000

# Allowed Frontend URL(s) for CORS (comma-separated if multiple)
# Example: https://ai-code-review-platform.vercel.app,http://localhost:5173
FRONTEND_URL=https://ai-code-review-platform.vercel.app
