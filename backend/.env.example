# Production Environment Variables Configuration
# Never commit the real .env file to version control.

# Database Connection String (MySQL 8.0)
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/code_review_db
DATABASE_URL=

# Cryptographic Secret Key for JWT token signing (generate with `openssl rand -hex 32`)
SECRET_KEY=

# AI Provider Configuration (gemini or openai)
LLM_API_KEY=
LLM_PROVIDER=gemini

# Application Environment & Port
APP_ENV=production
PORT=8000

# Allowed Frontend URL(s) for CORS (comma-separated if multiple)
# Example: https://your-frontend-domain.vercel.app
FRONTEND_URL=
